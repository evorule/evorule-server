{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evorule.org/schemas/_shared/v1.0.json",
  "title": "evorule 共享定义 v1.0（固化版）",
  "description": "跨 kind 共享的 $defs 单一事实源（SSOT，records/70）。transform_rule / domain / instruction 权威源为 evorule-tcb 源码（executor.rs 5 元指令 + domain.rs 7 基础域）；service_entry 权威源为 evorule-server io_handlers/src/service_registry.rs；llm_verdict（LLM 判定事实载荷）权威源即本定义，消费面为 evorule-rule 事实条目 schema_ref 与 evo-agent 判定产出侧。rule_set / migration 等 schema 通过跨文件 $ref 引用本文件，禁止复制粘贴导致漂移。",
  "$defs": {
    "path": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9_$\\-\\\\]+(?:\\[[0-9]+\\])?)(?:(?:\\.(?:[A-Za-z0-9_$\\-\\\\]+(?:\\[[0-9]+\\])?))|(?:\\.\\[[0-9]+\\]))*$",
      "not": {
        "pattern": "__io_result__"
      },
      "description": "路径语法（权威源 evorule-tcb/src/path.rs 实际解析器，分隔符仅 . [ \\，其余字符均为字段名）。identifier 允许 [A-Za-z0-9_$\\-\\\\]（含 $，兼容 __exec__.payload.$schema 迁移写法）；index = 1*DIGIT。拒绝空段（x. /.x /x..y /items[0]..name）、缺闭合括号（[0）、空索引（[]）、非数字索引（[abc]）、索引后非法拼接（[0]abc）。not.__io_result__：I/O 结果字段强制复数 __io_results__（P1-03），单数 __io_result__ 拒绝（yuanze-demos 08/012/013/014/016 高频运行时错误）。"
    },
    "payload_attr_path": {
      "allOf": [
        {
          "$ref": "#/$defs/path"
        },
        {
          "not": {
            "pattern": "^payload\\."
          }
        }
      ],
      "description": "写侧 attr 专用（set/increment/decrement 的 params.attr，方案 a）：语法同 path，但禁止 payload. 前缀。引擎语义：attr 相对 __exec__.payload 解析，带 payload. 前缀会双重嵌套写入 payload.payload.*（静默失败：不报错但写到错误位置，哨兵/业务规则永远读不到）。正确写法：直接写 payload 内相对路径（如 meta_guard.cleared_for_move），或用 __exec__.payload. 显式全形式。读侧（domain.path）不受此限——读路径相对 __exec__ 根，payload.x 恰是正确形态。引擎 exec_set 对运行时解析出的 payload. 前缀 attr 同样硬拒（双层防御，覆盖绕过 schema 的执行入口）。"
    },
    "path_or_literal": {
      "if": {
        "type": "string",
        "pattern": "^__"
      },
      "then": {
        "$ref": "#/$defs/path"
      },
      "description": "字面量或路径引用（与引擎 resolve_path_or_literal 语义一致）：非字符串、或非 __ 前缀字符串按字面量放行（如 service_name 字面量、中文提示词、数字）；__ 前缀字符串必须解析为合法路径（含复数强制）。防止把拼写错误的 __ 路径当字面量静默放过。"
    },
    "domain": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^__",
          "description": "路径引用动态域（如 __exec__.instruction.params.domain / __exec__.instruction.params.condition），引擎运行时求值。必须 __ 前缀：branch.domain 走 resolve_path_or_literal 不自动补全，非 __ 字符串会被当字面量并在 evaluate_domain 报 MissingField"
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "eq",
                "lt",
                "exists",
                "instruction",
                "all",
                "not",
                "has_fields"
              ],
              "description": "7 基础域类型（权威源 evorule-tcb/src/domain.rs L128-139）。派生域（gt/or/le/ge/ne）是 core_eval 用 all/not/lt/eq 组合出来的，不在枚举内。嵌套一律用 inner，禁止 domain/domains 字段（P0-03）。"
            },
            "path": {
              "$ref": "#/$defs/path",
              "description": "eq/lt/exists/has_fields 的求值路径（必填，纯路径语义，同 resolve_exec_path）"
            },
            "value": {
              "$ref": "#/$defs/path_or_literal",
              "description": "eq/lt 的字面量比较值；__ 前缀字符串按路径引用校验语法（语义上 eq/lt 比较字面量，见沙箱 P17）"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "eq"
                  }
                }
              },
              "then": {
                "required": [
                  "path",
                  "value"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "lt"
                  }
                }
              },
              "then": {
                "required": [
                  "path",
                  "value"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "exists"
                  }
                }
              },
              "then": {
                "required": [
                  "path"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "instruction"
                  }
                }
              },
              "then": {
                "required": [
                  "instruction_type"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "has_fields"
                  }
                }
              },
              "then": {
                "required": [
                  "path",
                  "fields"
                ],
                "properties": {
                  "fields": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "all"
                  }
                }
              },
              "then": {
                "required": [
                  "inner"
                ],
                "properties": {
                  "inner": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/domain"
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "not"
                  }
                }
              },
              "then": {
                "required": [
                  "inner"
                ],
                "properties": {
                  "inner": {
                    "$ref": "#/$defs/domain"
                  }
                }
              }
            }
          ],
          "additionalProperties": true
        }
      ]
    },
    "instruction": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^__",
          "description": "路径引用动态指令（如 __exec__.instruction.params.then），引擎运行时从指令 params 求值出指令对象（core_eval sequence/conditional 的 push.instructions 用法）。必须 __ 前缀：push.instructions 数组内非 __ 字符串会被当字面量指令压栈并在执行时报 MissingField"
        },
        {
          "type": "object",
          "description": "指令层业务指令（权威源：core_eval.json 中匹配的 instruction_type）。push.instructions 的项；结构宽松（type 任意字符串 + params）。注意：increment/decrement/noop/set 等指令层类型不等于元指令层类型。控制流指令（set/increment/decrement/sequence/conditional/while_loop）做结构门禁：set.attr 路径语法（防 x. 运行时错误）、sequence.instructions 数组、conditional/while_loop 的 domain 结构。",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string"
            },
            "params": {
              "type": "object"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "enum": [
                      "set",
                      "increment",
                      "decrement"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "params": {
                    "type": "object",
                    "required": [
                      "attr",
                      "operation"
                    ],
                    "properties": {
                      "attr": {
                        "$ref": "#/$defs/payload_attr_path",
                        "description": "必填：payload 路径；语法非法（如 x.）与 payload. 前缀双重嵌套（方案 a）在提交期即被拦截，避免运行时 PathResolutionFailed 或静默写歪"
                      },
                      "operation": {
                        "enum": [
                          "set",
                          "add",
                          "sub"
                        ],
                        "description": "必填；increment→add / decrement→sub / set→set"
                      },
                      "value": {
                        "$ref": "#/$defs/path_or_literal",
                        "description": "set 指令的值（字面量或 __ 路径引用）"
                      },
                      "delta": {
                        "description": "increment/decrement 指令的增量（core_eval 从 instruction.params.delta 读取）"
                      }
                    },
                    "additionalProperties": true
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "sequence"
                  }
                }
              },
              "then": {
                "properties": {
                  "params": {
                    "type": "object",
                    "required": [
                      "instructions"
                    ],
                    "properties": {
                      "instructions": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "$ref": "#/$defs/instruction"
                        }
                      }
                    },
                    "additionalProperties": true
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "conditional"
                  }
                }
              },
              "then": {
                "properties": {
                  "params": {
                    "type": "object",
                    "required": [
                      "domain",
                      "then",
                      "else"
                    ],
                    "properties": {
                      "domain": {
                        "$ref": "#/$defs/domain"
                      },
                      "then": {
                        "oneOf": [
                          {
                            "$ref": "#/$defs/instruction"
                          },
                          {
                            "type": "array",
                            "items": {
                              "$ref": "#/$defs/instruction"
                            }
                          }
                        ],
                        "description": "条件成立执行的指令（单条或数组，兼容 demos 写法）"
                      },
                      "else": {
                        "oneOf": [
                          {
                            "$ref": "#/$defs/instruction"
                          },
                          {
                            "type": "array",
                            "items": {
                              "$ref": "#/$defs/instruction"
                            }
                          }
                        ],
                        "description": "条件不成立执行的指令（单条或数组，兼容 demos 写法）"
                      }
                    },
                    "additionalProperties": true
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "while_loop"
                  }
                }
              },
              "then": {
                "properties": {
                  "params": {
                    "type": "object",
                    "required": [
                      "condition",
                      "body"
                    ],
                    "properties": {
                      "condition": {
                        "$ref": "#/$defs/domain"
                      },
                      "body": {
                        "oneOf": [
                          {
                            "$ref": "#/$defs/instruction"
                          },
                          {
                            "type": "array",
                            "items": {
                              "$ref": "#/$defs/instruction"
                            }
                          }
                        ],
                        "description": "循环体（单条或数组，兼容 demos 写法）"
                      }
                    },
                    "additionalProperties": true
                  }
                }
              }
            }
          ],
          "additionalProperties": true
        }
      ]
    },
    "transform_rule": {
      "type": "object",
      "required": [
        "type",
        "params"
      ],
      "properties": {
        "type": {
          "enum": [
            "set",
            "push",
            "branch",
            "io_request",
            "enforce"
          ],
          "description": "5 元指令类型（权威源 evorule-tcb/src/executor.rs META_INSTRUCTION_TYPES）。注意：noop/increment/decrement 是指令层，不是元指令层，不得出现在此枚举（P0-01）；enforce 仅允许出现在 L2 元规则文件（tier=meta），业务文件/L3 携带由 server 装载门禁拒载（回归验证）；collect/merge 已退役（规则清理方案 2026-09-14）。"
        },
        "params": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "条目级键白名单 = {type, params}，未知键 fail-fast（additionalProperties:false）。背景（意图静默丢失防御）：LLM 转写产物曾把匹配条件写成条目级 condition 字段，引擎静默忽略导致约束对所有指令无条件触发——条件语义只能经 params 内的 domain/enforce 原语表达；条目级未知键一律提交期报错并列明键名，杜绝起草意图在转写环节静默丢失。",
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "enforce"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": [
                  "domain",
                  "reason"
                ],
                "properties": {
                  "domain": {
                    "$ref": "#/$defs/domain",
                    "description": "匹配即强制中断剩余 transform 并拒绝执行违规指令（引擎级阻止，非留痕）；与 branch 的 domain 同构（7 域类型）"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "description": "必填违规说明：命中时随系统独占 Violation 事实审计回显；无 reason 的拦截不可审计，不允许静默强制"
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "set"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": [
                  "attr",
                  "operation",
                  "value"
                ],
                "properties": {
                  "attr": {
                    "$ref": "#/$defs/payload_attr_path",
                    "description": "payload 路径（相对或 __exec__.payload.X 全路径）；引用 __ 开头字段需显式前缀（core_eval v0.3.1 约束）；payload. 前缀禁止（方案 a，双重嵌套静默写歪）"
                  },
                  "operation": {
                    "enum": [
                      "set",
                      "add",
                      "sub"
                    ],
                    "description": "纯覆盖语义：业务 set 指令的 operation=set 固定为覆盖，params 里的 add/sub 会被忽略（A-1）；算术更新必须用 increment/decrement 指令 + set operation=add/sub"
                  },
                  "value": {
                    "$ref": "#/$defs/path_or_literal",
                    "description": "必填：字面量或 __ 开头路径引用字符串。引擎 exec_set 对缺失 value 报 MissingField（resolve_path_or_literal(None)）——不能省略；__ 路径必须语法合法（防 x. 等运行时错误）"
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "push"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": [
                  "instructions"
                ],
                "properties": {
                  "instructions": {
                    "oneOf": [
                      {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/instruction"
                        }
                      },
                      {
                        "type": "string",
                        "description": "路径引用（如 __exec__.instruction.params.instructions）"
                      }
                    ]
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "branch"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": [
                  "domain",
                  "on_true"
                ],
                "properties": {
                  "domain": {
                    "$ref": "#/$defs/domain"
                  },
                  "on_true": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/transform_rule"
                    }
                  },
                  "on_false": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/transform_rule"
                    }
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "io_request"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": [
                  "io_type"
                ],
                "properties": {
                  "io_type": {
                    "type": "string",
                    "description": "如 call_external / call_service；I/O 结果按 io_type 隔离写入 __io_results__.<io_type>（复数，P1-03）"
                  }
                },
                "additionalProperties": {
                  "$ref": "#/$defs/path_or_literal"
                },
                "description": "io_type 专属参数（call_external: messages 必填路径 + tools? 可选；call_service: service_name + args?）。可选参数必须以 '?' 后缀显式声明（审计决策）：键名带 ? 时路径解析失败可跳过（业务性缺省），不带 ? 时解析失败立即报错——可选必须显式声明，禁止静默推断。所有参数值经 resolve_path_or_literal：__ 前缀字符串必须语法合法（防 x. 等运行时错误）"
              }
            }
          }
        }
      ]
    },
    "service_entry": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "description": "必填；scheme 仅限 http/https（service_registry.rs 校验，防 file:///data:// 危险 scheme）"
        },
        "method": {
          "type": "string",
          "description": "可选，默认 POST（service_registry.rs unwrap_or POST）"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "可选；值必须是字符串；注册表 headers 优先于规则 params 的 headers（防规则私自加鉴权头）"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "可选；未设置时 HttpHandler 回退默认 10s"
        }
      },
      "additionalProperties": true,
      "description": "服务注册条目（权威源 service_registry.rs ServiceEntry）。解析器只读取 url/method/headers/timeout_ms，未知字段静默忽略——因此 additionalProperties 开放以向前兼容。body_template 在文档中宣称但解析器未读取，慎用。"
    },
    "llm_verdict": {
      "type": "object",
      "required": [
        "kind",
        "key",
        "verdict",
        "prompt_hash",
        "model",
        "origin"
      ],
      "properties": {
        "kind": {
          "const": "llm_verdict",
          "description": "事实类型标识，恒为 llm_verdict"
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9_][a-z0-9_.\\-]*$",
          "description": "判定键（如 content.safety）：规则条件经 payload 注入路径（facts.llm_verdict.<key>）用现有 exists/eq 原子消费此键；键名小写点分，防路径文法歧义"
        },
        "verdict": {
          "type": [
            "boolean",
            "string"
          ],
          "description": "判定结果：boolean；或字符串形态 pass/fail（二元判定惯例）。value 形态（判定产出数值/枚举值）时必须携带 value 字段"
        },
        "value": {
          "description": "判定产出的结构化值（verdict 为 value 形态时必填）；类型不限——具体键的业务类型由消费侧治理（evorule-rule 条目治理面）约束"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "可选，判定置信度（0-1）。仅供人类复核与观测面；不得进规则条件——不确定性不得写成确定性阈值假象"
        },
        "evidence": {
          "type": "string",
          "description": "判定依据摘录（输入原文片段），供审计链外的人类复核"
        },
        "prompt_hash": {
          "type": "string",
          "pattern": "^blake3:[0-9a-f]{64}$",
          "description": "判定所用 prompt 的 BLAKE3 指纹（存储口径带 blake3: 前缀，B 族哈希口径）——保「判了什么/依据什么」可溯源；不承诺判定可复现"
        },
        "model": {
          "type": "string",
          "description": "执行判定的模型标识（如 MiniMax-M2.5）"
        },
        "origin": {
          "const": "llm",
          "description": "事实来源恒为 llm——与机器归纳（sediment）/人类声明（stable）等其他来源 fact 区分；生命周期治理（Draft→审批→Active）由 evorule-rule 治理面承载"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verdict": {
