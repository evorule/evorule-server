{
  "$schema": "https://evorule.org/schemas/law_set/v1.0.json",
  "$id": "https://evorule.org/schemas/law_set/v1.0.json",
  "title": "Evorule Law Set",
  "type": "object",
  "required": ["$schema", "kind", "id", "version", "laws"],
  "properties": {
    "$schema": { "const": "https://evorule.org/schemas/law_set/v1.0.json" },
    "kind": { "const": "law_set" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "metadata": { "type": "object" },
    "laws": {
      "type": "array",
      "items": { "$ref": "#/$defs/law" },
      "maxItems": 128
    }
  },
  "$defs": {
    "law": {
      "type": "object",
      "required": ["id", "formula", "symbols", "si_units"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "formula": { "type": "string", "minLength": 3 },
        "symbols": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": { "type": "string" }
        },
        "si_units": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "symbol -> pint-parseable SI unit expression"
        },
        "domain": { "type": "string" },
        "domains": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "minItems": 1,
          "uniqueItems": true,
          "description": "多域归属（域向量扩多域；缺省=单域 domain 字段语义不变）"
        },
        "cross_refs": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["target", "domain"],
            "additionalProperties": false,
            "properties": {
              "target": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "被引用律式 id（同集内）" },
              "domain": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "引用边落点域（跨域声明）" }
            }
          },
          "description": "跨域引用边显式声明（D2=A：注册时声明，禁自动发现）"
        },
        "solvable": { "type": "array", "items": { "type": "string" } },
        "derivation": { "type": "array", "items": { "type": "string" } },
        "tier": { "enum": ["light", "full"], "default": "full" },
        "metadata": {
          "type": "object",
          "required": ["source"],
          "properties": { "source": { "type": "string" }, "verified": { "type": "string" } }
        }
      },
      "additionalProperties": false
    }
  }
}
