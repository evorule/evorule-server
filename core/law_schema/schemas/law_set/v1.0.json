{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evorule.org/schemas/law_set/v1.0.json",
  "title": "evorule law_set v1.0（固化版）",
  "description": "定律集合（law_set）数据集契约：恒真式定律条目数组（id/formula/symbols/si_units/max_version_depth/monotone_form 必填；tier=light|full；domains 多域向量与 cross_refs 跨域显式声明边；条目级 additionalProperties=false 严格形态，单文件自洽无跨文件 $ref）。2026-11-12 自 evorule-server core/law_schema 嵌入版归位本仓 SSOT（治理归位：实例校验语义与 server 嵌入版逐字段一致，仅补宪法头字段）；server 侧仍以嵌入副本执行运行时校验，副本一致性由 server check_schema_sync.py 对清单守卫。",
  "x_legal_authority_notice": "本 schema 由 EvoRule 团队维护,以 CC0 1.0 公共领域奉献(见 schemas/LICENSE-SCHEMAS.md);通过本 schema 校验或创作的 system JSON 内容 IP 归作者所有,evorule 不主张。详见 ../../LEGAL_NOTES.md 与 ../../docs/adr/scope-split-ip-model.md",
  "type": "object",
  "required": ["$schema", "kind", "id", "version", "laws"],
  "properties": {
    "$schema": { "const": "https://evorule.org/schemas/law_set/v1.0.json" },
    "kind": { "const": "law_set" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "metadata": { "type": "object" },
    "laws": {
      "type": "array",
      "items": { "$ref": "#/$defs/law" },
      "maxItems": 128
    }
  },
  "$defs": {
    "law": {
      "type": "object",
      "required": ["id", "formula", "symbols", "si_units", "max_version_depth", "monotone_form"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "formula": { "type": "string", "minLength": 3 },
        "symbols": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": { "type": "string" }
        },
        "si_units": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "symbol -> pint-parseable SI unit expression"
        },
        "domain": { "type": "string" },
        "domains": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "minItems": 1,
          "uniqueItems": true,
          "description": "多域归属（域向量扩多域；缺省=单域 domain 字段语义不变）"
        },
        "cross_refs": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["target", "domain"],
            "additionalProperties": false,
            "properties": {
              "target": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "被引用律式 id（同集内）" },
              "domain": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "引用边落点域（跨域声明）" }
            }
          },
          "description": "跨域引用边显式声明（D2=A：注册时声明，禁自动发现）"
        },
        "solvable": { "type": "array", "items": { "type": "string" } },
        "derivation": { "type": "array", "items": { "type": "string" } },
        "tier": { "enum": ["light", "full"], "default": "full" },
        "max_version_depth": {
          "type": "integer",
          "minimum": 1,
          "description": "版本链高度 h_p（有限性声明）：该律式版本链的最大深度，必填且 ≥1"
        },
        "monotone_form": {
          "type": "boolean",
          "description": "单调形态声明：值必须为 true（非单调形态律式拒收，须以时间锚定改写重交）"
        },
        "time_anchor": {
          "type": "string",
          "minLength": 1,
          "description": "时间锚定改写声明锚（可选；formula 命中否定类构造时必须非空）"
        },
        "metadata": {
          "type": "object",
          "required": ["source"],
          "properties": { "source": { "type": "string" }, "verified": { "type": "string" } }
        }
      },
      "additionalProperties": false
    }
  }
}
