{
  "$schema": "https://evorule.org/schemas/rule_set/v1.0.json",
  "kind": "rule_set",
  "id": "org.evorule.bundle.bundle_ds_yuanze_01_v3.rule_sandbox_validate",
  "version": "1.0.0",
  "metadata": {
    "description": "存量 bundle 条目带壳整改（2026-09-15，原裸数组零语义变更）；壳为治理标注层，引擎仍取 transform",
    "license": "AGPL-3.0-or-later",
    "provenance": {
      "source": "derived",
      "derived_from": [
        "rule-sandbox-validate.json"
      ]
    }
  },
  "transform": [
    {
      "params": {
        "domain": {
          "instruction_type": "sandbox_validate",
          "type": "instruction"
        },
        "on_true": [
          {
            "params": {
              "domain": {
                "path": "__exec__.payload.__io_results__.call_service",
                "type": "exists"
              },
              "on_false": [
                {
                  "params": {
                    "attr": "_sandbox_args.candidate_rule",
                    "operation": "set",
                    "value": "__exec__.payload.audit.generated_patch_raw"
                  },
                  "type": "set"
                },
                {
                  "params": {
                    "attr": "_sandbox_args.test_cases",
                    "operation": "set",
                    "value": "__exec__.payload.audit.compacted_log"
                  },
                  "type": "set"
                },
                {
                  "params": {
                    "args": "__exec__.payload._sandbox_args",
                    "io_type": "call_service",
                    "service_name": "rule_sandbox"
                  },
                  "type": "io_request"
                }
              ],
              "on_true": [
                {
                  "params": {
                    "attr": "audit.sandbox_verdict",
                    "operation": "set",
                    "value": "__exec__.payload.__io_results__.call_service"
                  },
                  "type": "set"
                }
              ]
            },
            "type": "branch"
          }
        ]
      },
      "type": "branch"
    }
  ]
}