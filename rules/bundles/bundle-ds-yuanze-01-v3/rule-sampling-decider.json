{
  "$schema": "https://evorule.org/schemas/rule_set/v1.0.json",
  "kind": "rule_set",
  "id": "org.evorule.bundle.bundle_ds_yuanze_01_v3.rule_sampling_decider",
  "version": "1.0.0",
  "metadata": {
    "description": "存量 bundle 条目带壳整改（2026-09-15，原裸数组零语义变更）；壳为治理标注层，引擎仍取 transform",
    "license": "AGPL-3.0-or-later",
    "provenance": {
      "source": "derived",
      "derived_from": [
        "rule-sampling-decider.json"
      ]
    }
  },
  "transform": [
    {
      "params": {
        "domain": {
          "instruction_type": "sampling_decider",
          "type": "instruction"
        },
        "on_true": [
          {
            "params": {
              "domain": {
                "path": "__exec__.payload.__io_results__.call_service",
                "type": "exists"
              },
              "on_false": [
                {
                  "params": {
                    "args": "__exec__.instruction.params",
                    "io_type": "call_service",
                    "service_name": "__exec__.instruction.params.sampling_service"
                  },
                  "type": "io_request"
                }
              ],
              "on_true": [
                {
                  "params": {
                    "attr": "audit.trigger_shadow",
                    "operation": "set",
                    "value": "__exec__.payload.__io_results__.call_service.trigger"
                  },
                  "type": "set"
                },
                {
                  "params": {
                    "attr": "audit.counter",
                    "operation": "set",
                    "value": "__exec__.payload.__io_results__.call_service.counter"
                  },
                  "type": "set"
                }
              ]
            },
            "type": "branch"
          }
        ]
      },
      "type": "branch"
    }
  ]
}