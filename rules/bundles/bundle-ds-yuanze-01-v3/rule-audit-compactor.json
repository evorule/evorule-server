{
  "$schema": "https://evorule.org/schemas/rule_set/v1.0.json",
  "kind": "rule_set",
  "id": "org.evorule.bundle.bundle_ds_yuanze_01_v3.rule_audit_compactor",
  "version": "1.0.0",
  "metadata": {
    "description": "存量 bundle 条目带壳整改（2026-09-15，原裸数组零语义变更）；壳为治理标注层，引擎仍取 transform",
    "license": "AGPL-3.0-or-later",
    "provenance": {
      "source": "derived",
      "derived_from": [
        "rule-audit-compactor.json"
      ]
    }
  },
  "transform": [
    {
      "params": {
        "domain": {
          "instruction_type": "audit_compactor",
          "type": "instruction"
        },
        "on_true": [
          {
            "params": {
              "domain": {
                "path": "__exec__.payload.audit.compacted_log",
                "type": "exists"
              },
              "on_false": [
                {
                  "params": {
                    "attr": "audit.compacted_log.init_audit",
                    "operation": "set",
                    "value": "__exec__.instruction.params.timestamp"
                  },
                  "type": "set"
                }
              ],
              "on_true": [
                {
                  "params": {
                    "attr": "audit.compacted_log.last_audit",
                    "operation": "set",
                    "value": "__exec__.instruction.params.timestamp"
                  },
                  "type": "set"
                },
                {
                  "params": {
                    "attr": "audit.compacted_log.counter",
                    "operation": "set",
                    "value": "__exec__.payload.audit.counter"
                  },
                  "type": "set"
                }
              ]
            },
            "type": "branch"
          },
          {
            "params": {
              "attr": "audit.input_snapshot",
              "operation": "set",
              "value": null
            },
            "type": "set"
          },
          {
            "params": {
              "attr": "audit.pending_alert",
              "operation": "set",
              "value": null
            },
            "type": "set"
          }
        ]
      },
      "type": "branch"
    }
  ]
}