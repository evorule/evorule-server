[
  {
    "type": "enforce",
    "params": {
      "domain": {
        "type": "all",
        "inner": [
          { "type": "not", "inner": { "type": "instruction", "instruction_type": "branch" } },
          { "type": "not", "inner": { "type": "instruction", "instruction_type": "set" } },
          { "type": "not", "inner": { "type": "instruction", "instruction_type": "push" } },
          { "type": "not", "inner": { "type": "instruction", "instruction_type": "io_request" } },
          { "type": "not", "inner": { "type": "instruction", "instruction_type": "enforce" } }
        ]
      },
      "reason": "DC-01 未知元指令类型：core_eval 只承认 branch/set/push/io_request/enforce（SSOT: executor.rs META_INSTRUCTION_TYPES）"
    }
  },
  {
    "type": "enforce",
    "params": {
      "domain": {
        "type": "all",
        "inner": [
          { "type": "instruction", "instruction_type": "enforce" },
          { "type": "eq", "path": "instruction._ctx.nested", "value": true, "on_missing": "unsat" }
        ]
      },
      "reason": "DC-02 enforce 必须顶层声明：嵌入 branch 子指令时受『传播即停』影响，违反条件时不会 Halted（残留风险 R-1）"
    }
  },
  {
    "type": "enforce",
    "params": {
      "domain": {
        "type": "all",
        "inner": [
          { "type": "instruction", "instruction_type": "enforce" },
          { "type": "not", "inner": { "type": "exists", "path": "instruction.params.reason" } }
        ]
      },
      "reason": "DC-03 enforce 必须携带 params.reason：缺 reason 时 Halted 信号无违规说明，Violation 事实不可审计"
    }
  },
  {
    "type": "enforce",
    "params": {
      "domain": {
        "type": "all",
        "inner": [
          { "type": "instruction", "instruction_type": "io_request" },
          { "type": "not", "inner": { "type": "exists", "path": "instruction.params.io_type" } }
        ]
      },
      "reason": "DC-04 io_request 必须携带 params.io_type：缺失时上层无法路由 I/O"
    }
  },
  {
    "type": "enforce",
    "params": {
      "domain": {
        "type": "all",
        "inner": [
          { "type": "instruction", "instruction_type": "io_request" },
          { "type": "eq", "path": "instruction._ctx.shadowed", "value": true, "on_missing": "unsat" }
        ]
      },
      "reason": "DC-05 io_request 被前置早退规则遮蔽：更靠前的规则已对同一指令类型返回信号，本规则永不求值（BUG-P0-005 同型）"
    }
  },
  {
    "type": "enforce",
    "params": {
      "domain": {
        "type": "all",
        "inner": [
          { "type": "instruction", "instruction_type": "set" },
          {
            "type": "not",
            "inner": {
              "type": "all",
              "inner": [
                { "type": "eq", "path": "instruction._ctx.has_attr", "value": true, "on_missing": "unsat" },
                { "type": "eq", "path": "instruction._ctx.has_value", "value": true, "on_missing": "unsat" }
              ]
            }
          }
        ]
      },
      "reason": "DC-06 set 必须携带 params.attr 与 params.value 两个字段（按字段存在性判定而非值非空：value=null 是受支持的『置空/清除』语义，见 domain.rs exists『null 视为已清除』）"
    }
  },
  {
    "type": "enforce",
    "params": {
      "domain": {
        "type": "all",
        "inner": [
          { "type": "instruction", "instruction_type": "branch" },
          { "type": "not", "inner": { "type": "exists", "path": "instruction.params.domain" } }
        ]
      },
      "reason": "DC-07 branch 必须携带 params.domain：无条件 branch 退化为无条件跳转，违反确定性契约"
    }
  },
  {
    "type": "enforce",
    "params": {
      "domain": {
        "type": "all",
        "inner": [
          { "type": "instruction", "instruction_type": "io_request" },
          { "type": "exists", "path": "instruction._ctx.io_in_tree" },
          {
            "type": "not",
            "inner": {
              "type": "lt",
              "path": "instruction._ctx.io_in_tree",
              "value": 2,
              "on_missing": "unsat"
            }
          }
        ]
      },
      "reason": "DC-08 (TCB_SPEC D4) 一条规则内最多一个 io_request：__io_results__ 按 io_type 隔离，多个 io_request 会覆盖冲突"
    }
  },
  {
    "type": "enforce",
    "params": {
      "domain": {
        "type": "all",
        "inner": [
          { "type": "instruction", "instruction_type": "io_request" },
          { "type": "eq", "path": "instruction._ctx.preceded_by_mutating", "value": true, "on_missing": "unsat" }
        ]
      },
      "reason": "DC-09 (TCB_SPEC D5) io_request 必须是叶子：其前不得有 set/push 等修改状态的操作，否则部分修改丢弃（IoRequired 纯信号）会破坏重放等价性 D11"
    }
  }
]
