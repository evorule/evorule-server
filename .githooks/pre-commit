#!/bin/sh
# EvoRule pre-commit hook: 文档同步检查
# 安装方式: git config core.hooksPath .githooks
# 此钩子调用 PowerShell 脚本 scripts/pre-commit-doc-check.ps1
# 提示性钩子，不会阻断 commit

# 检测 Windows 环境并调用 PowerShell
if command -v powershell.exe >/dev/null 2>&1; then
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "scripts/pre-commit-doc-check.ps1"
elif command -v pwsh >/dev/null 2>&1; then
    pwsh -NoProfile -ExecutionPolicy Bypass -File "scripts/pre-commit-doc-check.ps1"
else
    echo "[doc-check] 未检测到 PowerShell，跳过文档同步检查。"
    echo "             请手动运行: powershell -File scripts/pre-commit-doc-check.ps1"
fi

# 提示性钩子，始终 exit 0
exit 0
